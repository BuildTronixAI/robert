# Robert COO — production activation template
# Copy to /etc/robert/secrets.env (or load via systemd EnvironmentFile).
# Do not commit real secrets.

# ── Required core ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=                 # preferred for user JWT apikey header
SUPABASE_JWT_SECRET=               # REQUIRED — Telegram identity mint (missing = refuse listen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Governance / mesh ───────────────────────────────────────────────────────
BOB_SHARED_SECRET=                 # required — no empty/dev fallback
BOB_INBOX_URL=                     # required for ROBERT_MESH_PHASE=C
BOB_PUBLIC_KEY_HEX=                # Ed25519 public key (64 hex chars)
ROBERT_GATE_LEVEL=1                # set to 2 when approval quorum is live
ROBERT_MESH_PHASE=B                # set to C after mesh_nonces.sql + BOB inbox live
ROBERT_AUDITED_WRITES_ENABLED=false
ROBERT_GATE_AUDIT_STRICT=false     # true = fail-closed on policy persist errors

# ── Paths ───────────────────────────────────────────────────────────────────
WORKSPACE_PATH=/var/lib/robert/workspace
ROBERT_STORE_DB=/var/lib/robert/workspace/robert_runtime.db
ROBERT_MEMORY_PATH=/var/lib/robert/workspace/robert_memory.json

# ── Optional tools ──────────────────────────────────────────────────────────
RESEND_API_KEY=
GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# ── Precon API ──────────────────────────────────────────────────────────────
PRECON_API_TOKEN=                  # Bearer token for mutating Precon routes
PRECON_DEV_SEED=0                  # 1 = auto-seed mock project data (dev only)
PRECON_AUTH_DISABLED=0             # 1 = disable Bearer auth (local tests only)
PRECON_GATE_AUDIT_STRICT=0         # 1 = fail loud if execution_spine audit write fails
FRONTEND_URL=https://buildtronix.ai

# ── Activation checklist ────────────────────────────────────────────────────
# 1. Fill required secrets above; never commit this file with real values
# 2. psql $DATABASE_URL -f deploy/mesh_nonces.sql
# 3. Restart robert.service; confirm Telegram "Robert online"
# 4. Smoke: send a task from Chris; expect SUCCESS_REPLY
# 5. When BOB inbox ready: ROBERT_MESH_PHASE=C
# 6. When approval quorum ready: ROBERT_GATE_LEVEL=2
# 7. Precon API: set PRECON_API_TOKEN; keep PRECON_DEV_SEED=0 in prod
