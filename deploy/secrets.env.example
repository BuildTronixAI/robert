# Robert COO — secrets.env TEMPLATE (source of truth for /etc/robert/secrets.env)
# Copy to /etc/robert/secrets.env and fill values. Do NOT commit real secrets.
# If config sync generates the live file, sync FROM this template — never the reverse.
#
# Loaded by systemd: EnvironmentFile=/etc/robert/secrets.env
# See also: deploy/verify_deploy.sh, robert.service

# ── Required ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=                 # required for Anthropic/Haiku paths (Witness/LV/reviewer)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional / mesh ─────────────────────────────────────────────────────────
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
BOB_SHARED_SECRET=
BOB_INBOX_URL=
ROBERT_GATE_LEVEL=1
ROBERT_MESH_PHASE=B

# ── Paths ───────────────────────────────────────────────────────────────────
WORKSPACE_PATH=/var/lib/robert/workspace
ROBERT_MEMORY_PATH=/var/lib/robert/workspace/robert_memory.json

# ROBERT_RESET_CHAT_HISTORY: leave UNSET. Only set =1 (one-shot,
# stamp-guarded) or =force (override stamp) for an intentional
# history wipe. Remove after the deploy restart. Never bake into
# templates or config sync.
# ROBERT_RESET_CHAT_HISTORY=
